# PostgreSQL (obligatorio en Render; el disco gratuito es efímero)
DATABASE_URL=postgresql://usuario:clave@host:5432/contable

# 1 si el proveedor exige SSL (Neon, Render externo). 0 en red interna sin SSL.
DATABASE_SSL=0

# Solo desarrollo local, si no hay DATABASE_URL. En producción se rechaza el arranque.
# SQLITE_PATH=data/contable.db

PORT=3001
NODE_ENV=development
SESSION_SECRET=cambie-esta-clave-larga-y-aleatoria

# Contraseña del usuario admin la primera vez que la base está vacía.
ADMIN_PASSWORD=Consultora2026!
